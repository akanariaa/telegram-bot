# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# LLM API (OpenAI-compatible)
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# YouTube Archiving - Backblaze B2
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_ENDPOINT_URL=https://s3.eu-central-1.s4.mega.io
B2_BUCKET_NAME=archive

# Proxy (optional)
USE_PROXY=false
PROXY_PROTOCOL=socks5
PROXY_HOST_PORT=127.0.0.1:8002
PROXY_USERNAME=
PROXY_PASSWORD=

# Docker proxy container name (optional)
DOCKER_PROXY_CONTAINER=docker-warproxy3

# Allowed Telegram User IDs (comma-separated, empty = allow all)
ALLOWED_USER_IDS=